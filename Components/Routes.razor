<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(R2WebExtensions).Assembly }" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(R2Layout)">
            <NotAuthorized><R2NotAuthorized /></NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
