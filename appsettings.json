{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Connection strings (Default = iSupport_Archive on sql1, IntranetSecurity, CommonData) are never kept here: they're
  // set on the app pool by Setup-LocalIIS.ps1 (your PC) and deploy\Setup-IIS.ps1 (the server).
  "R2": {
    "AppName": "Archived iSupport Tickets",
    // Nothing in the app needs roles: staff are the do_it_staff AD group, and there's nothing to administer. No
    // IntranetSecurity application by this name exists, so nobody gets the admin pages. Add one later if that changes.
    "Security": { "ApplicationName": "iSupportArchiveV2" },
    // The app doesn't log: iSupport_Archive is a read-only archive, and no connection string by this name exists,
    // so log entries are skipped without touching any database.
    "Logging": { "ConnectionStringName": "AppLog" },
    "Email": { "Enabled": false },
    // The AD group whose members see every ticket; everyone else sees only tickets they opened.
    "Archive": { "StaffGroup": "do_it_staff" }
  }
}
