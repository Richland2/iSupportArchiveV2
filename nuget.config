<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!-- These two need credentials, which are never stored here: each developer adds them once to their own user
         settings, under these same names, with "dotnet nuget update source" (see README.md). -->
    <add key="Telerik" value="https://nuget.telerik.com/v3/index.json" />
    <add key="R2" value="https://nuget.pkg.github.com/Richland2/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- R2Platform only from the district's feed, Telerik's UI only from Telerik's, everything else from nuget.org -->
    <packageSource key="R2">
      <package pattern="R2.*" />
    </packageSource>
    <packageSource key="Telerik">
      <package pattern="Telerik.UI.for.Blazor" />
    </packageSource>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
