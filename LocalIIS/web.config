<?xml version="1.0" encoding="utf-8"?>
<!--
  For your PC's IIS only (http://localhost:88/iSupportArchiveV2, set up by Setup-LocalIIS.ps1). Each Debug build publishes the
  app into bin\LocalIIS, the folder that IIS application points at, and copies this file there. It is never part of
  a deploy: the servers get the web.config that "dotnet publish" makes.

  Shadow copying: IIS runs a copy of the app from obj\IISShadowCopy, so a build while the site is running isn't
  blocked by locked files, and IIS restarts the app on the new build. Build, then refresh the browser.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\iSupportArchiveV2.exe" stdoutLogEnabled="false" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
        </environmentVariables>
        <handlerSettings>
          <handlerSetting name="enableShadowCopy" value="true" />
          <handlerSetting name="shadowCopyDirectory" value="..\..\obj\IISShadowCopy\" />
        </handlerSettings>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
